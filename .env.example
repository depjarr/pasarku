# Pilih SALAH SATU penyedia AI (cukup isi satu key):

# 1) Google Gemini — gratis, buat key di https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# 2) Groq — gratis & sangat cepat, buat key di https://console.groq.com/keys
GROQ_API_KEY=

# 3) Vercel AI Gateway (opsional)
AI_GATEWAY_API_KEY=

# Opsional: ganti model, mis. gemini-3.1-pro-preview atau openai/gpt-oss-20b
# AI_MODEL=

# Foto menu & langkah resep dari Google Images (lewat Serper.dev — gratis 2.500 pencarian)
# Daftar di https://serper.dev lalu salin API key dari dashboard
SERPER_API_KEY=
